#!/bin/bash
#SBATCH --job-name=flowdata
#SBATCH --partition=cpu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=12
#SBATCH --time=24:00:00
#SBATCH --array=0-3
#SBATCH --output=slurm_flowdata_%A_%a.out

# Flow-field dataset generation for the Transolver surrogate on the CPU
# partition (karen/plankton, no GPU: reconstruction runs with --device cpu).
# 4 array tasks x 30 shape seeds; SEED_OFFSET 200 covers seeds 200-319
# (= 240 samples at 1 base + 1 jitter) with the volume-targeted sampler.
# Seeds 0-179 on disk come from the older radius-uniform sampler.
# Resumable: existing npz are skipped.

source tests/env.sh
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK

SHAPES_PER_TASK=30
SEED_OFFSET=${SEED_OFFSET:-200}  # override: sbatch --export=ALL,SEED_OFFSET=0 ...
START=$((SEED_OFFSET + SLURM_ARRAY_TASK_ID * SHAPES_PER_TASK))

uv run python scripts/generate_flow_dataset.py \
    --config experiments/flow_dataset/config_dataset.json \
    --start "$START" --count "$SHAPES_PER_TASK" --device cpu \
    --run-tag "${SLURM_ARRAY_JOB_ID}"
