#!/bin/bash
#SBATCH --job-name=flowdata
#SBATCH --partition=compute
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=24:00:00
#SBATCH --array=0-9
#SBATCH --output=slurm_flowdata_%A_%a.out

# Flow-field dataset generation for the Transolver surrogate.
# Each array task generates SHAPES_PER_TASK shape seeds (x (1+jitter) variants).
# Adjust --array and SHAPES_PER_TASK to cover dataset.n_shapes in the config.

source tests/env.sh

SHAPES_PER_TASK=6
START=$((SLURM_ARRAY_TASK_ID * SHAPES_PER_TASK))

uv run python scripts/generate_flow_dataset.py \
    --config experiments/flow_dataset/config_dataset.json \
    --start "$START" --count "$SHAPES_PER_TASK"
