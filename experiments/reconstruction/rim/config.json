{
  "run": {
    "name": "results",
    "device": "cuda",
    "debug": false,
    "heavy_data_dir": "${DEEPSHAPEOPT_RESULTS_DIR}"
  },
  "geometry": {
    "mesh_path": "${DEEPSHAPEOPT_DATA_DIR}/shapes/rim.stl",
    "unit_to_metre": 1.0
  },
  "parametrization": {
    "type": "deepsdf",
    "deepsdf": {
      "model_path": "${DEEPSHAPEOPT_MODEL_DIR}/primitives_cl32",
      "checkpoint": "latest",
      "tiling": [
        6,
        12,
        12
      ],
      "spline_degree": [
        1,
        1,
        1
      ],
      "tiling_map": "hat",
      "reconstruction": {
        "n_uniform_samples": 100000,
        "n_surface_samples": 500000,
        "samples_surface_stds": [
          0.005,
          0.0001
        ],
        "lr": 0.005,
        "num_iterations": 25,
        "batch_size": 4096,
        "code_bound": 1.0,
        "code_reg_lambda": 0.0,
        "grad_clip": 1.0,
        "eikonal_lambda": 0.0,
        "mesh_device": "cuda",
        "export_resolution": 12
      }
    }
  }
}
