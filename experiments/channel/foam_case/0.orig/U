FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        // Feed port at y_min: inflow along +y.
        type            fixedValue;
        value           uniform (0 0.1 0);
    }
    outlet
    {
        type            zeroGradient;
    }
    outletInterior
    {
        type            zeroGradient;
    }
    walls
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    sensitivity_region
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
}

