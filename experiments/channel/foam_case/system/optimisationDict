FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      optimisationDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

optimisationManager    singleRun;

primalSolvers
{
    p1
    {
        active                 true;
        type                   incompressible;
        solver                 simple;

        solutionControls
        {
            nIters 500; // very low!, if this is changed, also change runApplication reconstructPar -time 300,500 in Allrun purgeWrite in controlDict
            residualControl
            {
                "p.*"       1.e-99;
                "U.*"       1.e-99;
            }
        }
    }
}

adjointManagers
{
    am1
    {
        primalSolver             p1;
        adjointSolvers
        {
            as1
            {
                // choose adjoint solver
                //----------------------
                active                 true;
                type                   incompressible;
                solver                 adjointSimple;
                computeSensitivities   true;
                // useSolverNameForFields true;

                // manage objectives
                //------------------
                objectives
                {
                    type                incompressible;
                    objectiveNames
                    {
                        // losses
                        // {
                        //     weight            0.000005;
                        //     type              PtLosses;
                        //     patches           (inlet outlet);
                        //     normalise         false;
                        // }

                            // Original all-direction uniformity (fallback). To use
                            // it instead: comment the uniformityDirectional block
                            // below, uncomment this one, and set
                            // optimization.objective_name = "uniformityas1" in config.json.
                        // uniformity
                        // {
                        //     weight            1;
                        //     type              uniformityPatch;
                        //     patches           (outletInterior);
                        //     normalise         false;
                        // }

                            // Make U uniform along -z (uniformDirection: the outlet
                            // slot at z=3.1817 discharges downward into the die gap) on
                            // outletInterior; drive the transverse (x,y) components to
                            // 0 over the whole outlet (outlet + outletInterior).
                            // Requires libcustomAdjointObjectives.so (loaded in controlDict).
                        uniformityDirectional
                        {
                            weight            1;
                            type              uniformityPatchDirectional;
                            parallelPatches   (outletInterior);
                            transversePatches (outlet outletInterior);
                            uniformDirection  (0 0 -1);
                            transverseWeight  1.0;
                            normalise         false;
                        }
                    }
                }

                // ATC treatment
                //--------------
                ATCModel
                {
                    ATCModel        standard;
                }

                // solution control
                //------------------
                solutionControls
                {
                    nIters 500; // very low! if this is changed, also change runApplication reconstructPar -time 300,500 in Allrun purgeWrite in controlDict
                    residualControl
                    {
                        "pa.*"       1.e-99;
                        "Ua.*"       1.e-99;
                    }
                }
            }
            as2
            {
                // choose adjoint solver
                //----------------------
                active                 true;
                type                   incompressible;
                solver                 adjointSimple;
                computeSensitivities   true;
                // useSolverNameForFields true;
                // isConstraint           true ;

                // manage objectives
                //------------------
                objectives
                {
                    type                incompressible;
                    objectiveNames
                    {
                        losses
                        {
                            weight            1.0;
                            type              PtLosses;
                            patches           (inlet outlet);
                            normalise         false;
                        }

                    }
                }

                // ATC treatment
                //--------------
                ATCModel
                {
                    ATCModel        standard;
                }

                // solution control
                //------------------
                solutionControls
                {
                    nIters 500; // very low! if this is changed, also change runApplication reconstructPar -time 300,500 in Allrun and purgeWrite in controlDict
                    residualControl
                    {
                        "pa.*"       1.e-99;
                        "Ua.*"       1.e-99;
                    }
                }
            }



        }
    }
}

optimisation
{
    designVariables
    {
        sensitivityType surfacePoints;
        patches          (sensitivity_region);
        includeSurfaceArea true; // defalut = false
        includeMeshMovement true; // default = true (ESI), false: SI
        writeAllSurfaceFiles         true;
        // writeAllFields              true;
    }
}


