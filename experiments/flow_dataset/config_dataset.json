  "optimization": {
    "debug": false,
    "mesh_resolution": 48,
    "mesh_pipeline": "sdf_hex",
    "sdf_hex": {
      "domain": [[-5.0, -5.0, -5.0], [15.0, 5.0, 5.0]],
