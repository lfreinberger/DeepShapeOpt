{
  "results_name": "flow_dataset_v1",
  "reconstruction": {
    "mesh_path": "__PER_SAMPLE__",
    "model_path": "${DEEPSHAPEOPT_MODEL_DIR}/primitives_cl32",
    "model_checkpoint": "latest",
    "tiling": [2, 2, 2],
    "spline_degree": [1, 1, 1],
    "design_domain": [[-1.5, -0.8, -0.8], [1.5, 0.8, 0.8]],
    "n_uniform_samples": 100000,
    "n_surface_samples": 500000,
    "lr": 5e-3,
    "num_iterations": 15,
    "batch_size": 4096,
    "code_reg_lambda": 0.0,
    "code_bound": 1.0,
    "grad_clip": 1.0,
    "eikonal_lambda": 0.0,
