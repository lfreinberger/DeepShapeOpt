/*--------------------------------*- C++ -*----------------------------------*\
| DAFoam case template (discrete adjoint) -- external flow, drag              |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

// DAFoam manages the time loop; endTime is the hard cap, the stop criterion is
// daOptions.primalMinResTol (see ../../deepshapeopt/dafoam_utils.py).
application     simpleFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         2000;
deltaT          1;
writeControl    timeStep;
writeInterval   2000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  16;
writeCompression off;
timeFormat      general;
timePrecision   16;
runTimeModifiable true;
