/*--------------------------------*- C++ -*----------------------------------*\
| DAFoam case template (discrete adjoint) -- external flow, drag              |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

SIMPLE
{
    consistent false;
    nNonOrthogonalCorrectors 0;
}
solvers
{
    // The primal pressure AND DAFoam's pseudo-pressure share this entry: pEqn.solve() looks
    // up solvers/p and DASimpleFoam reads solverDictP_ from the same place; pFinal is not
    // consulted. The pseudo-pressure matrix is the transposed (asymmetric) and nearly
    // singular Laplacian of the fixed-point adjoint -- GAMG and every Krylov method run it
    // to nan, only a stationary smoother carries it. Costs the primal multigrid.
    "(p|Phi)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        relTol          0.1;
        tolerance       1e-14;
        nSweeps         2;
        maxIter         1000;
    }
    "(U|nuTilda)"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        relTol          0.1;
        tolerance       1e-16;
        nSweeps         1;
        maxIter         50;
    }
}
relaxationFactors
{
    fields { p 0.3; }
    equations { "(U|nuTilda)" 0.3; }
}
potentialFlow { nNonOrthogonalCorrectors 20; }
