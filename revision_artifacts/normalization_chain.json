  "tile_aspect_ratios": {
    "purpose": "The quantity that determines how far the decoder is queried from its training regime is the TILE aspect ratio, not the design-box aspect ratio.",
    "training_reference": {
      "scene_box": "[-1,1]^3",
      "tiling": "8x8x8",
      "tile": "0.25 x 0.25 x 0.25",
      "aspect": 1.0
    },
    "reconstruction": [
      {
        "case": "Rim",
        "tiling": "6x12x12",
        "tile_aspect": 1.07
      },
      {
        "case": "Flow channel",
        "tiling": "1x8x8",
        "tile_aspect": 1.19
      },
      {
        "case": "Dog (shiba)",
        "tiling": "4x12x12",
        "tile_aspect": 1.5
      },
      {
        "case": "Propeller",
        "tiling": "12x12x4",
        "tile_aspect": 1.57
      }
    ],
    "optimization": [
      {
        "case": "Experiment 1 (cube)",
        "tiling": "2x2x2",
        "tile_aspect": 1.88
      },
      {
        "case": "Experiment 2 (cube with cylinders)",
        "tiling": "2x2x2",
        "tile_aspect": 2.0
      }
    ],
    "interpretation": "Tilings that look strongly anisotropic as integer triples (e.g. 1x8x8) in fact produce NEAR-CUBIC tiles, because the tiling is matched to the proportions of the geometry. The reconstruction cases stay within 1.07-1.57 of the cubic training tile. The optimization cases are the most elongated (1.88-2.00) because a coarse 2x2x2 lattice is applied to an elongated design box. So the decoder operates near its training regime throughout, and the departure is a controllable consequence of the chosen control lattice.",
    "method": "normalize_mesh_to_unit_cube on the target mesh (reconstruction) or fit_box_to_unit_cube on the design domain (optimization), then extent / tiling per axis."
  }
