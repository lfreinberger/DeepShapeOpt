#!/bin/sh
# Build the custom adjoint objective library into the user's OpenFOAM space
# ($FOAM_USER_LIBBIN). The shared OpenFOAM installation is not modified.
#
# Requires the OpenFOAM environment to be sourced first, e.g.:
#   source /programs/shared/openfoam/OpenFOAM-v2506/etc/bashrc
#
cd "${0%/*}" || exit 1                       # run from this directory

if [ -z "$WM_PROJECT_DIR" ]; then
    echo "Allwmake: OpenFOAM environment not sourced (\$WM_PROJECT_DIR unset)." 1>&2
    echo "          source <OpenFOAM>/etc/bashrc and retry." 1>&2
    exit 1
fi

wmake libso objectiveUniformityPatchDirectional

echo "Built libcustomAdjointObjectives into: $FOAM_USER_LIBBIN"
