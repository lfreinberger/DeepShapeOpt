+void DAResidualSimpleFoam::calcPCMatWithFvMatrix(Mat PCMat)
+{
+    /*
+    Description:
+        Assemble the block-diagonal part of dRdW^T (dR_U/dU, dR_p/dp and the
+        dR_phi/dphi diagonal) directly from OpenFOAM's fvMatrix coefficients.
+        No coloring and no AD, so this costs about one equation assembly instead
+        of one AD sweep per color.
+
+        The equations mirror calcResiduals above one-to-one, with the first-order
+        "div(pc)" convection scheme that the preconditioner path uses, so the
+        preconditioner matches the discretization it is meant to precondition.
+
+        NOTE: the row/column indices are swapped in every MatSetValues call below,
+        i.e. we assemble the TRANSPOSE, matching what calcdRdWT(isPC=1) produces.
+        Only internal faces are touched, so every entry lands in the processor's
+        own diagonal block (this is what makes the preallocation in
+        DASolver::initializePCMatFvMatrix trivial).
+    */
+
+    const labelUList& owner = mesh_.owner();
+    const labelUList& neighbour = mesh_.neighbour();
+
+    PetscScalar val;
+
+    dictionary normStateDict = daOption_.getAllOptions().subDict("normalizeStates");
+    wordList normResDict = daOption_.getOption<wordList>("normalizeResiduals");
+
+    if (hasFvSource_)
+    {
+        DAFvSource& daFvSource(const_cast<DAFvSource&>(
+            mesh_.thisDb().lookupObject<DAFvSource>("DAFvSource")));
+        daFvSource.calcFvSource(fvSource_);
+    }
+
+    // ******************** U ********************
+    scalar UScaling = 1.0;
+    if (normStateDict.found("U"))
+    {
+        UScaling = normStateDict.getScalar("U");
+    }
+    scalar UResScaling = 1.0;
+
+    tmp<fvVectorMatrix> tUEqn(
+        fvm::div(phi_, U_, "div(pc)")
+        + fvm::Sp(alphaPorosity_, U_)
+        + MRF_.DDt(U_)
+        + daTurb_.divDevReff(U_)
+        - fvSource_
+        - fvOptions_(U_));
+    fvVectorMatrix& UEqn = tUEqn.ref();
+
+    // The AD differentiates through the under-relaxation: relax(alpha) scales the diagonal
+    // by 1/alpha but puts (1-alpha)/alpha*A*U back into the source, and that U is the state
+    // itself, so the two cancel and the exact dR_U/dU is the UNRELAXED matrix.  Taking the
+    // relaxed D() instead inflates the diagonal by ~1/alpha (measured: 1.386 at alpha=0.7).
+    // Snapshot the coefficients here; the relaxed equation is still what rAU and the
+    // pressure equation below need -- the p block matches the AD matrix to 1e-10 that way.
+    scalarField UEqnD(UEqn.D());
+    scalarField UEqnLower(UEqn.lower());
+    scalarField UEqnUpper(UEqn.upper());
+
+    UEqn.relax();
+    fvOptions_.constrain(UEqn);
+    forAll(U_, cellI)
+    {
+        if (normResDict.found("URes"))
+        {
+            UResScaling = mesh_.V()[cellI];
+        }
+        for (label i = 0; i < 3; i++)
+        {
+            PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("U", cellI, i);
+            PetscInt colI = rowI;
+            scalar val1 = UEqnD[cellI] * UScaling / UResScaling;
+            assignValueCheckAD(val, val1);
+            MatSetValues(PCMat, 1, &rowI, 1, &colI, &val, INSERT_VALUES);
+        }
+    }
+
+    for (label faceI = 0; faceI < daIndex_.nLocalInternalFaces; faceI++)
+    {
+        label ownerCellI = owner[faceI];
+        label neighbourCellI = neighbour[faceI];
+
+        if (normResDict.found("URes"))
+        {
+            UResScaling = mesh_.V()[neighbourCellI];
+        }
+        for (label i = 0; i < 3; i++)
+        {
+            PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("U", neighbourCellI, i);
+            PetscInt colI = daIndex_.getGlobalAdjointStateIndex("U", ownerCellI, i);
+            scalar val1 = UEqnLower[faceI] * UScaling / UResScaling;
+            assignValueCheckAD(val, val1);
+            MatSetValues(PCMat, 1, &colI, 1, &rowI, &val, INSERT_VALUES);
+        }
+    }
+
+    for (label faceI = 0; faceI < daIndex_.nLocalInternalFaces; faceI++)
+    {
+        label ownerCellI = owner[faceI];
+        label neighbourCellI = neighbour[faceI];
+
+        if (normResDict.found("URes"))
+        {
+            UResScaling = mesh_.V()[ownerCellI];
+        }
+        for (label i = 0; i < 3; i++)
+        {
+            PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("U", ownerCellI, i);
+            PetscInt colI = daIndex_.getGlobalAdjointStateIndex("U", neighbourCellI, i);
+            scalar val1 = UEqnUpper[faceI] * UScaling / UResScaling;
+            assignValueCheckAD(val, val1);
+            MatSetValues(PCMat, 1, &colI, 1, &rowI, &val, INSERT_VALUES);
+        }
+    }
+
+    // ******************** p ********************
+    // same construction as calcResiduals: rAU/HbyA/phiHbyA, then the pressure Laplacian
+    label pRefCell = 0;
+    scalar pRefValue = 0.0;
+
+    volScalarField rAU(1.0 / UEqn.A());
+    autoPtr<volVectorField> HbyAPtr = nullptr;
+    label useConstrainHbyA = daOption_.getOption<label>("useConstrainHbyA");
+    if (useConstrainHbyA)
+    {
+        HbyAPtr.reset(new volVectorField(constrainHbyA(rAU * UEqn.H(), U_, p_)));
+    }
+    else
+    {
+        HbyAPtr.reset(new volVectorField("HbyA", U_));
+        HbyAPtr() = rAU * UEqn.H();
+    }
+    volVectorField& HbyA = HbyAPtr();
+
+    surfaceScalarField phiHbyA("phiHbyA", fvc::flux(HbyA));
+    MRF_.makeRelative(phiHbyA);
+    adjustPhi(phiHbyA, U_, p_);
+
+    tmp<volScalarField> rAtU(rAU);
+    if (simple_.consistent())
+    {
+        rAtU = 1.0 / (1.0 / rAU - UEqn.H1());
+        phiHbyA += fvc::interpolate(rAtU() - rAU) * fvc::snGrad(p_) * mesh_.magSf();
+        HbyA -= (rAU - rAtU()) * fvc::grad(p_);
+    }
+
+    tUEqn.clear();
+
+    constrainPressure(p_, U_, phiHbyA, rAtU(), MRF_);
+
+    fvScalarMatrix pEqn(
+        fvm::laplacian(rAtU(), p_)
+        == fvc::div(phiHbyA));
+    pEqn.setReference(pRefCell, pRefValue);
+
+    scalar pScaling = 1.0;
+    if (normStateDict.found("p"))
+    {
+        pScaling = normStateDict.getScalar("p");
+    }
+    scalar pResScaling = 1.0;
+
+    scalarField pEqnD = pEqn.D();
+    forAll(p_, cellI)
+    {
+        if (normResDict.found("pRes"))
+        {
+            pResScaling = mesh_.V()[cellI];
+        }
+        PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("p", cellI);
+        PetscInt colI = rowI;
+        scalar val1 = pEqnD[cellI] * pScaling / pResScaling;
+        assignValueCheckAD(val, val1);
+        MatSetValues(PCMat, 1, &rowI, 1, &colI, &val, INSERT_VALUES);
+    }
+
+    for (label faceI = 0; faceI < daIndex_.nLocalInternalFaces; faceI++)
+    {
+        label ownerCellI = owner[faceI];
+        label neighbourCellI = neighbour[faceI];
+
+        if (normResDict.found("pRes"))
+        {
+            pResScaling = mesh_.V()[neighbourCellI];
+        }
+        PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("p", neighbourCellI);
+        PetscInt colI = daIndex_.getGlobalAdjointStateIndex("p", ownerCellI);
+        scalar val1 = pEqn.lower()[faceI] * pScaling / pResScaling;
+        assignValueCheckAD(val, val1);
+        MatSetValues(PCMat, 1, &colI, 1, &rowI, &val, INSERT_VALUES);
+    }
+
+    for (label faceI = 0; faceI < daIndex_.nLocalInternalFaces; faceI++)
+    {
+        label ownerCellI = owner[faceI];
+        label neighbourCellI = neighbour[faceI];
+
+        if (normResDict.found("pRes"))
+        {
+            pResScaling = mesh_.V()[ownerCellI];
+        }
+        PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("p", ownerCellI);
+        PetscInt colI = daIndex_.getGlobalAdjointStateIndex("p", neighbourCellI);
+        scalar val1 = pEqn.upper()[faceI] * pScaling / pResScaling;
+        assignValueCheckAD(val, val1);
+        MatSetValues(PCMat, 1, &colI, 1, &rowI, &val, INSERT_VALUES);
+    }
+
+    // ******************** phi ********************
+    // The Pimple template fills no phi block at all, which would leave these rows
+    // empty and the preconditioner singular.  calcResiduals has
+    //     phiRes = phiHbyA - pEqn.flux() - phi
+    // so dR_phi/dphi is -1, scaled like the other states.  The gate measurement
+    // (blockdiag vs phidiag, both 151 GMRES iterations) showed that this diagonal
+    // is all the phi block has to contribute.
+    // Both scalings for phi are magSf and therefore cancel:
+    //   state scaling    -- DAPartDeriv.C overrides normalizeStates["phi"] with magSf
+    //   residual scaling -- normalizePhiResiduals divides phiRes by magSf
+    // so the normalized diagonal is exactly -1 (confirmed against the AD-built matrix,
+    // whose phi diagonal has magnitude 1.000e+00).
+    label normPhiState = normStateDict.found("phi");
+    label normPhiRes = normResDict.found("phiRes");
+
+    // phi is indexed over ALL local faces (internal first, then every boundary face) --
+    // see DAField::ofField2StateVec, which loops forAll(mesh_.faces(), faceI).
+    forAll(mesh_.faces(), faceI)
+    {
+        scalar magSfI = 1.0;
+        if (faceI < daIndex_.nLocalInternalFaces)
+        {
+            magSfI = mesh_.magSf()[faceI];
+        }
+        else
+        {
+            label relIdx = faceI - daIndex_.nLocalInternalFaces;
+            const label& patchIdx = daIndex_.bFacePatchI[relIdx];
+            const label& faceIdx = daIndex_.bFaceFaceI[relIdx];
+            magSfI = mesh_.magSf().boundaryField()[patchIdx][faceIdx];
+        }
+
+        scalar stateScale = normPhiState ? magSfI : 1.0;
+        scalar resScale = normPhiRes ? magSfI : 1.0;
+
+        PetscInt rowI = daIndex_.getGlobalAdjointStateIndex("phi", faceI);
+        PetscInt colI = rowI;
+        scalar val1 = -1.0 * stateScale / resScale;
+        assignValueCheckAD(val, val1);
+        MatSetValues(PCMat, 1, &rowI, 1, &colI, &val, INSERT_VALUES);
+    }
+}
 // * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
 
 } // End namespace Foam
