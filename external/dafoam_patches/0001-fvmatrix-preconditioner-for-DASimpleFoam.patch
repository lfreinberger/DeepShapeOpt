+void DASolver::initializePCMatFvMatrix(Mat PCMat)
+{
+    /*
+    Description:
+        Size and preallocate a preconditioner matrix for the block-diagonal assembly in
+        calcPCMatWithFvMatrix, WITHOUT running the dRdW coloring.
+
+        calcPCMatWithFvMatrix only ever couples a cell to its internal-face neighbours
+        within the same state (dR_U/dU, dR_p/dp, dR_<model>/d<model>) and puts a plain
+        diagonal on the surface-scalar states.  Every entry therefore lands in the
+        processor's own diagonal block, so the off-processor preallocation is zero.
+
+        Row counts:
+          cell states (vector, scalar, model): 1 + number of internal faces of the cell
+          surface scalar states (phi):         1
+    */
+
+    label localSize = daIndexPtr_->nLocalAdjointStates;
+
+    // internal-face neighbour count per cell
+    labelList nIntFaces(meshPtr_->nCells(), 0);
+    const labelUList& owner = meshPtr_->owner();
+    const labelUList& neighbour = meshPtr_->neighbour();
+    for (label faceI = 0; faceI < daIndexPtr_->nLocalInternalFaces; faceI++)
+    {
+        nIntFaces[owner[faceI]]++;
+        nIntFaces[neighbour[faceI]]++;
+    }
+
+    labelList dNnz(localSize, 1);
+    labelList oNnz(localSize, 0);
+
+    forAll(stateInfo_["volVectorStates"], idxI)
+    {
+        const word stateName = stateInfo_["volVectorStates"][idxI];
+        forAll(meshPtr_->cells(), cellI)
+        {
+            for (label comp = 0; comp < 3; comp++)
+            {
+                label idx = daIndexPtr_->getLocalAdjointStateIndex(stateName, cellI, comp);
+                dNnz[idx] = 1 + nIntFaces[cellI];
+            }
+        }
+    }
+    forAll(stateInfo_["volScalarStates"], idxI)
+    {
+        const word stateName = stateInfo_["volScalarStates"][idxI];
+        forAll(meshPtr_->cells(), cellI)
+        {
+            label idx = daIndexPtr_->getLocalAdjointStateIndex(stateName, cellI);
+            dNnz[idx] = 1 + nIntFaces[cellI];
+        }
+    }
+    forAll(stateInfo_["modelStates"], idxI)
+    {
+        const word stateName = stateInfo_["modelStates"][idxI];
+        forAll(meshPtr_->cells(), cellI)
+        {
+            label idx = daIndexPtr_->getLocalAdjointStateIndex(stateName, cellI);
+            dNnz[idx] = 1 + nIntFaces[cellI];
+        }
+    }
+    // surface scalar states keep the default 1 (diagonal only)
+
+    MatSetSizes(PCMat, localSize, localSize, PETSC_DETERMINE, PETSC_DETERMINE);
+    MatSetFromOptions(PCMat);
+    MatMPIAIJSetPreallocation(PCMat, 0, dNnz.begin(), 0, oNnz.begin());
+    MatSeqAIJSetPreallocation(PCMat, 0, dNnz.begin());
+    MatSetUp(PCMat);
+    MatZeroEntries(PCMat);
+
+    Info << "PC mat (fvMatrix, no coloring) created. "
+         << meshPtr_->time().elapsedCpuTime() << " s" << endl;
+}
