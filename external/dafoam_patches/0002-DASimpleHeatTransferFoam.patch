diff --git a/src/adjoint/DAResidual/DAResidualSimpleHeatTransferFoam.C b/src/adjoint/DAResidual/DAResidualSimpleHeatTransferFoam.C
new file mode 100644
index 0000000..741825c
--- /dev/null
+++ b/src/adjoint/DAResidual/DAResidualSimpleHeatTransferFoam.C
@@ -0,0 +1,141 @@
+/*---------------------------------------------------------------------------*\
+
+    DAFoam  : Discrete Adjoint with OpenFOAM
+    Version : v5
+
+\*---------------------------------------------------------------------------*/
+
+#include "DAResidualSimpleHeatTransferFoam.H"
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+namespace Foam
+{
+
+defineTypeNameAndDebug(DAResidualSimpleHeatTransferFoam, 0);
+addToRunTimeSelectionTable(DAResidual, DAResidualSimpleHeatTransferFoam, dictionary);
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+
+DAResidualSimpleHeatTransferFoam::DAResidualSimpleHeatTransferFoam(
+    const word modelType,
+    const fvMesh& mesh,
+    const DAOption& daOption,
+    const DAModel& daModel,
+    const DAIndex& daIndex)
+    : DAResidualSimpleFoam(modelType, mesh, daOption, daModel, daIndex),
+      T_(const_cast<volScalarField&>(
+          mesh_.thisDb().lookupObject<volScalarField>("T"))),
+      DT_("DT", dimViscosity, 0.0),
+      cp_("cp", dimensionSet(0, 2, -2, -1, 0, 0, 0), 0.0),
+      viscosityCoeffsPtr_(nullptr)
+{
+    // the base class has created TRes; its own (passive) T equation is
+    // switched off here, the energy equation below replaces it
+    hasTField_ = 0;
+
+    IOdictionary transportProperties(
+        IOobject(
+            "transportProperties",
+            mesh.time().constant(),
+            mesh,
+            IOobject::MUST_READ,
+            IOobject::NO_WRITE,
+            false));
+
+    DT_.read(transportProperties);
+    cp_.read(transportProperties);
+
+    const word transportModel(transportProperties.get<word>("transportModel"));
+    if (transportModel == viscosityModels::powerLawArrhenius::typeName)
+    {
+        viscosityCoeffsPtr_.reset(new viscosityModels::powerLawArrhenius::coeffs(
+            transportProperties.optionalSubDict(transportModel + "Coeffs")));
+    }
+    else if (transportModel != "Newtonian")
+    {
+        FatalErrorIn("DAResidualSimpleHeatTransferFoam")
+            << "transportModel " << transportModel << " is not differentiated; "
+            << "use Newtonian or powerLawArrhenius"
+            << abort(FatalError);
+    }
+}
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+void DAResidualSimpleHeatTransferFoam::clear()
+{
+    /*
+    Description:
+        Clear all members to avoid memory leak because we will initalize 
+        multiple objects of DAResidual. Here we need to delete all members
+        in the parent and child classes
+    */
+    DAResidualSimpleFoam::clear();
+    TResPtr_->clear();
+}
+
+void DAResidualSimpleHeatTransferFoam::calcResiduals(const dictionary& options)
+{
+    /*
+    Description:
+        U, p and phi residuals of DASimpleFoam, then the energy equation
+        (copied from TEqnSimpleHeatTransfer.H)
+    */
+
+    DAResidualSimpleFoam::calcResiduals(options);
+
+    // ******** T Residuals **************
+    volScalarField& TRes_ = TResPtr_();
+
+    const volTensorField gradU(fvc::grad(U_));
+    const volScalarField nu(daTurb_.nu());
+    const volTensorField tau(nu * (gradU + gradU.T()));
+
+    fvScalarMatrix TEqn(
+        fvm::div(phi_, T_)
+        - fvm::laplacian(DT_, T_)
+        == (1.0 / cp_) * (tau && gradU));
+
+    TEqn.relax();
+
+    TRes_ = TEqn & T_;
+    normalizeResiduals(TRes);
+}
+
+void DAResidualSimpleHeatTransferFoam::updateIntermediateVariables()
+{
+    /* 
+    Description:
+        Update the intermediate variables that depend on the state variables.
+        nu is written straight into the field the viscosity model registered,
+        which is the one DATurbulenceModel::nu() returns.
+    */
+    DAResidualSimpleFoam::updateIntermediateVariables();
+
+    if (viscosityCoeffsPtr_)
+    {
+        volScalarField& nu = const_cast<volScalarField&>(
+            mesh_.thisDb().lookupObject<volScalarField>("nu"));
+        nu = viscosityModels::powerLawArrhenius::calcNu(viscosityCoeffsPtr_(), U_, T_);
+    }
+}
+
+void DAResidualSimpleHeatTransferFoam::correctBoundaryConditions()
+{
+    /* 
+    Description:
+        Update the boundary condition for all the states in the selected solver
+    */
+    DAResidualSimpleFoam::correctBoundaryConditions();
+    T_.correctBoundaryConditions();
+}
+
+void DAResidualSimpleHeatTransferFoam::calcPCMatWithFvMatrix(Mat PCMat)
+{
+    FatalErrorIn("DAResidualSimpleHeatTransferFoam::calcPCMatWithFvMatrix")
+        << "no fvMatrix preconditioner for the T block yet; use the coloring one"
+        << abort(FatalError);
+}
+
+} // End namespace Foam
+
+// ************************************************************************* //
diff --git a/src/adjoint/DAResidual/DAResidualSimpleHeatTransferFoam.H b/src/adjoint/DAResidual/DAResidualSimpleHeatTransferFoam.H
new file mode 100644
index 0000000..cb4bc77
--- /dev/null
+++ b/src/adjoint/DAResidual/DAResidualSimpleHeatTransferFoam.H
@@ -0,0 +1,96 @@
+/*---------------------------------------------------------------------------*\
+
+    DAFoam  : Discrete Adjoint with OpenFOAM
+    Version : v5
+
+    Description:
+        Child class for DASimpleHeatTransferFoam
+
+        U, p and phi residuals are DASimpleFoam's. The T residual is the energy
+        equation of DASimpleHeatTransferFoam including viscous dissipation.
+
+        For transportModel powerLawArrhenius, nu is re-evaluated from the
+        current U and T (unrelaxed) in updateIntermediateVariables, which
+        DASolver calls before every residual evaluation, also inside the AD
+        tape. dnu/dU and dnu/dT are therefore part of dR/dW, and the shape
+        derivative through grad(U) part of dR/dXv. For Newtonian, nu is a
+        constant and nothing is re-evaluated. Any other viscosity model would
+        give a frozen-viscosity adjoint and is rejected.
+
+\*---------------------------------------------------------------------------*/
+
+#ifndef DAResidualSimpleHeatTransferFoam_H
+#define DAResidualSimpleHeatTransferFoam_H
+
+#include "DAResidualSimpleFoam.H"
+#include "powerLawArrhenius.H"
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+namespace Foam
+{
+
+/*---------------------------------------------------------------------------*\
+      Class DAResidualSimpleHeatTransferFoam Declaration
+\*---------------------------------------------------------------------------*/
+
+class DAResidualSimpleHeatTransferFoam
+    : public DAResidualSimpleFoam
+{
+protected:
+    /// temperature state
+    volScalarField& T_;
+
+    /// thermal diffusivity [m2/s]
+    dimensionedScalar DT_;
+
+    /// specific heat capacity [m2/(s2 K)]
+    dimensionedScalar cp_;
+
+    /// coefficients of powerLawArrhenius; null for Newtonian
+    autoPtr<viscosityModels::powerLawArrhenius::coeffs> viscosityCoeffsPtr_;
+
+public:
+    TypeName("DASimpleHeatTransferFoam");
+    // Constructors
+
+    //- Construct from components
+    DAResidualSimpleHeatTransferFoam(
+        const word modelType,
+        const fvMesh& mesh,
+        const DAOption& daOption,
+        const DAModel& daModel,
+        const DAIndex& daIndex);
+
+    //- Destructor
+    virtual ~DAResidualSimpleHeatTransferFoam()
+    {
+    }
+
+    // Members
+
+    /// clear the members
+    virtual void clear();
+
+    /// compute residual
+    virtual void calcResiduals(const dictionary& options);
+
+    /// update nu(U, T) and the intermediate variables of DASimpleFoam
+    virtual void updateIntermediateVariables();
+
+    /// update the boundary condition for all the states in the selected solver
+    virtual void correctBoundaryConditions();
+
+    /// the inherited U/p/phi block would leave the T rows empty; refuse it
+    virtual void calcPCMatWithFvMatrix(Mat PCMat);
+};
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+} // End namespace Foam
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+#endif
+
+// ************************************************************************* //
diff --git a/src/adjoint/DASolver/DASimpleHeatTransferFoam/DASimpleHeatTransferFoam.C b/src/adjoint/DASolver/DASimpleHeatTransferFoam/DASimpleHeatTransferFoam.C
