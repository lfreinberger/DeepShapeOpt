+#include "DASimpleHeatTransferFoam.H"
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+namespace Foam
+{
+
+defineTypeNameAndDebug(DASimpleHeatTransferFoam, 0);
+addToRunTimeSelectionTable(DASolver, DASimpleHeatTransferFoam, dictionary);
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+
+DASimpleHeatTransferFoam::DASimpleHeatTransferFoam(
+    char* argsAll,
+    PyObject* pyOptions)
+    : DASimpleFoam(argsAll, pyOptions),
+      DTPtr_(nullptr),
+      cpPtr_(nullptr)
+{
+    if (!hasTField_)
+    {
+        FatalErrorIn("DASimpleHeatTransferFoam")
+            << "DASimpleHeatTransferFoam needs a temperature field 0/T"
+            << abort(FatalError);
+    }
+}
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+void DASimpleHeatTransferFoam::initSolver()
+{
+    /*
+    Description:
+        Initialize variables for DASolver
+    */
+
+    Info << "Initializing fields for DASimpleHeatTransferFoam" << endl;
+    Time& runTime = runTimePtr_();
+    fvMesh& mesh = meshPtr_();
+#include "createSimpleControlPython.H"
+#include "createFieldsSimpleHeatTransfer.H"
+
+    // read the RAS model from constant/turbulenceProperties
+    const word turbModelName(
+        IOdictionary(
+            IOobject(
+                "turbulenceProperties",
+                mesh.time().constant(),
+                mesh,
+                IOobject::MUST_READ,
+                IOobject::NO_WRITE,
+                false))
+            .subDict("RAS")
+            .lookup("RASModel"));
+    daTurbulenceModelPtr_.reset(DATurbulenceModel::New(turbModelName, mesh, daOptionPtr_()));
+
+#include "createAdjoint.H"
+
+    // initialize fvSource and compute the source term
+    const dictionary& allOptions = daOptionPtr_->getAllOptions();
+    if (allOptions.subDict("fvSource").toc().size() != 0)
+    {
+        hasFvSource_ = 1;
+        Info << "Initializing DASource" << endl;
+        word sourceName = allOptions.subDict("fvSource").toc()[0];
+        word fvSourceType = allOptions.subDict("fvSource").subDict(sourceName).getWord("type");
+        daFvSourcePtr_.reset(DAFvSource::New(
+            fvSourceType, mesh, daOptionPtr_(), daModelPtr_(), daIndexPtr_()));
+    }
+}
+
+label DASimpleHeatTransferFoam::solvePrimal()
+{
+    /*
+    Description:
+        Call the primal solver to get converged state variables
+    */
+
+#include "createRefsSimple.H"
+#include "createFvOptions.H"
+
+    // call correctNut, this is equivalent to turbulence->validate();
+    daTurbulenceModelPtr_->updateIntermediateVariables();
+
+    Info << "\nStarting time loop\n"
+         << endl;
+
+    while (this->loop(runTime)) // using simple.loop() will have seg fault in parallel
+    {
+
+        if (printToScreen_)
+        {
+            Info << "Time = " << runTime.timeName() << nl << endl;
+        }
+
+        p.storePrevIter();
+
+        // --- Pressure-velocity SIMPLE corrector, then the energy equation
+        //     with the just-updated U (order of simpleHeatTransfer)
+        {
+#include "UEqnSimple.H"
+#include "pEqnSimple.H"
+#include "TEqnSimpleHeatTransfer.H"
+        }
+
+        // nu from the new T and strain rate (under-relaxed by the model)
+        laminarTransport.correct();
+        daTurbulenceModelPtr_->correct(printToScreen_);
+
+        // calculate all functions
+        this->calcAllFunctions(printToScreen_);
+        // calculate yPlus
+        daTurbulenceModelPtr_->printYPlus(printToScreen_);
+        // compute the regression model and print the feature
+        regModelFail_ = daRegressionPtr_->compute();
+        daRegressionPtr_->printInputInfo(printToScreen_);
+        // print run time
+        this->printElapsedTime(runTime, printToScreen_);
+
+        runTime.write();
+    }
+
+    // write the mesh to files
+    mesh.write();
+
+    // write associated fields such as URel
+    this->writeAssociatedFields();
+
+    Info << "End\n"
+         << endl;
+
+    return this->checkPrimalFailure();
+}
+
+label DASimpleHeatTransferFoam::runFPAdj(
+    Vec dFdW,
+    Vec psi)
+{
+    FatalErrorIn("DASimpleHeatTransferFoam::runFPAdj")
+        << "the fixed-point adjoint is not implemented for DASimpleHeatTransferFoam; "
+        << "use adjEqnSolMethod Krylov"
+        << abort(FatalError);
+    return 1;
+}
+
+} // End namespace Foam
+
+// ************************************************************************* //
diff --git a/src/adjoint/DASolver/DASimpleHeatTransferFoam/DASimpleHeatTransferFoam.H b/src/adjoint/DASolver/DASimpleHeatTransferFoam/DASimpleHeatTransferFoam.H
new file mode 100644
index 0000000..c510c2e
--- /dev/null
+++ b/src/adjoint/DASolver/DASimpleHeatTransferFoam/DASimpleHeatTransferFoam.H
@@ -0,0 +1,84 @@
+/*---------------------------------------------------------------------------*\
+
+    DAFoam  : Discrete Adjoint with OpenFOAM
+    Version : v5
+
+    Description:
+        Steady incompressible flow of a generalized-Newtonian melt with an
+        energy equation, the discrete counterpart of DeepShapeOpt's
+        simpleHeatTransfer primal:
+
+            U, p:  SIMPLE as in DASimpleFoam, nu from constant/transportProperties
+            T:     div(phi,T) - laplacian(DT,T) == (1/cp)*(tau && grad(U)),
+                   tau = nu*(grad(U) + grad(U)^T)
+
+        DT [m2/s] and cp [m2/(s2 K)] are read from constant/transportProperties.
+        Any viscosity model may be selected there; for powerLawArrhenius the
+        residual re-evaluates nu(U, T) before every residual call, so the AD
+        differentiates the full U-T-nu coupling (DAResidualSimpleHeatTransferFoam).
+
+        Everything except the fields and the two equation loops is inherited
+        from DASimpleFoam; the fixed-point adjoint is not available.
+
+\*---------------------------------------------------------------------------*/
+
+#ifndef DASimpleHeatTransferFoam_H
+#define DASimpleHeatTransferFoam_H
+
+#include "DASimpleFoam.H"
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+namespace Foam
+{
+
+/*---------------------------------------------------------------------------*\
+      Class DASimpleHeatTransferFoam Declaration
+\*---------------------------------------------------------------------------*/
+
+class DASimpleHeatTransferFoam
+    : public DASimpleFoam
+{
+
+protected:
+    /// thermal diffusivity [m2/s]
+    autoPtr<dimensionedScalar> DTPtr_;
+
+    /// specific heat capacity [m2/(s2 K)]
+    autoPtr<dimensionedScalar> cpPtr_;
+
+public:
+    TypeName("DASimpleHeatTransferFoam");
+    // Constructors
+
+    //- Construct from components
+    DASimpleHeatTransferFoam(
+        char* argsAll,
+        PyObject* pyOptions);
+
+    //- Destructor
+    virtual ~DASimpleHeatTransferFoam()
+    {
+    }
+
+    /// initialize fields and variables
+    virtual void initSolver();
+
+    /// solve the primal equations
+    virtual label solvePrimal();
+
+    /// the fixed-point adjoint of DASimpleFoam does not know T; refuse it
+    virtual label runFPAdj(
+        Vec dFdW,
+        Vec psi);
+};
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+} // End namespace Foam
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+#endif
+
+// ************************************************************************* //
diff --git a/src/adjoint/DASolver/DASimpleHeatTransferFoam/TEqnSimpleHeatTransfer.H b/src/adjoint/DASolver/DASimpleHeatTransferFoam/TEqnSimpleHeatTransfer.H
new file mode 100644
index 0000000..c72a878
--- /dev/null
+++ b/src/adjoint/DASolver/DASimpleHeatTransferFoam/TEqnSimpleHeatTransfer.H
@@ -0,0 +1,26 @@
+{
+    volScalarField& T = TPtr_();
+    const dimensionedScalar& DT = DTPtr_();
+    const dimensionedScalar& cp = cpPtr_();
+
+    // viscous dissipation, same as DeepShapeOpt's simpleHeatTransfer
+    const volTensorField gradU(fvc::grad(U));
+    const volScalarField nu(laminarTransport.nu());
+    const volTensorField tau(nu * (gradU + gradU.T()));
+
+    fvScalarMatrix TEqn(
+        fvm::div(phi, T)
+        - fvm::laplacian(DT, T)
+        == (1.0 / cp) * (tau && gradU));
+
+    TEqn.relax();
+
+    // get the solver performance info such as initial
+    // and final residuals
+    SolverPerformance<scalar> solverT = TEqn.solve();
+
+    DAUtility::primalResidualControl(solverT, printToScreen_, "T", daGlobalVarPtr_->primalMaxRes);
+
+    // bound T
+    DAUtility::boundVar(allOptions, T, printToScreen_);
+}
diff --git a/src/adjoint/DASolver/DASimpleHeatTransferFoam/createFieldsSimpleHeatTransfer.H b/src/adjoint/DASolver/DASimpleHeatTransferFoam/createFieldsSimpleHeatTransfer.H
new file mode 100644
index 0000000..69340c9
--- /dev/null
+++ b/src/adjoint/DASolver/DASimpleHeatTransferFoam/createFieldsSimpleHeatTransfer.H
@@ -0,0 +1,87 @@
+Info << "Reading field p\n"
+     << endl;
+pPtr_.reset(
+    new volScalarField(
+        IOobject(
+            "p",
+            runTime.timeName(),
+            mesh,
+            IOobject::MUST_READ,
+            IOobject::AUTO_WRITE),
+        mesh));
+volScalarField& p = pPtr_();
+
+Info << "Reading field U\n"
+     << endl;
+UPtr_.reset(
+    new volVectorField(
+        IOobject(
+            "U",
+            runTime.timeName(),
+            mesh,
+            IOobject::MUST_READ,
+            IOobject::AUTO_WRITE),
+        mesh));
+volVectorField& U = UPtr_();
+
+// T before the transport model: a temperature-dependent viscosity model
+// looks T up in its constructor
+Info << "Reading field T\n"
+     << endl;
+TPtr_.reset(
+    new volScalarField(
+        IOobject(
+            "T",
+            runTime.timeName(),
+            mesh,
+            IOobject::MUST_READ,
+            IOobject::AUTO_WRITE),
+        mesh));
+
+#include "createPhiPython.H"
+
+// create alpha porosity term
+alphaPorosityPtr_.reset(
+    new volScalarField(
+        IOobject(
+            "alphaPorosity",
+            runTime.timeName(),
+            mesh,
+            IOobject::READ_IF_PRESENT,
+            IOobject::AUTO_WRITE),
+        mesh,
+        dimensionedScalar("alphaPorosity", dimensionSet(0, 0, -1, 0, 0, 0, 0), pTraits<scalar>::zero),
+        zeroGradientFvPatchField<scalar>::typeName));
+
+// actuator related stuff
+Info << "Creating source term. " << endl;
+fvSourcePtr_.reset(
+    new volVectorField(
+        IOobject(
+            "fvSource",
+            runTime.timeName(),
+            mesh,
+            IOobject::NO_READ,
+            IOobject::AUTO_WRITE),
+        mesh,
+        dimensionedVector("fvSource", dimensionSet(0, 1, -2, 0, 0, 0, 0), vector::zero),
+        zeroGradientFvPatchField<vector>::typeName));
+
+setRefCell(p, simple.dict(), pRefCell_, pRefValue_);
+mesh.setFluxRequired(p.name());
+
+laminarTransportPtr_.reset(
+    new singlePhaseTransportModel(U, phi));
+singlePhaseTransportModel& laminarTransport = laminarTransportPtr_();
+
+turbulencePtr_.reset(
+    incompressible::turbulenceModel::New(U, phi, laminarTransport));
+
+// create MRF
+MRFPtr_.reset(new IOMRFZoneListDF(mesh));
+
+DTPtr_.reset(
+    new dimensionedScalar("DT", dimViscosity, laminarTransport));
+
+cpPtr_.reset(
+    new dimensionedScalar("cp", dimensionSet(0, 2, -2, -1, 0, 0, 0), laminarTransport));
diff --git a/src/adjoint/DAStateInfo/DAStateInfoSimpleHeatTransferFoam.C b/src/adjoint/DAStateInfo/DAStateInfoSimpleHeatTransferFoam.C
new file mode 100644
index 0000000..04df449
--- /dev/null
+++ b/src/adjoint/DAStateInfo/DAStateInfoSimpleHeatTransferFoam.C
@@ -0,0 +1,99 @@
+/*---------------------------------------------------------------------------*\
+
+    DAFoam  : Discrete Adjoint with OpenFOAM
+    Version : v5
+
+\*---------------------------------------------------------------------------*/
+
+#include "DAStateInfoSimpleHeatTransferFoam.H"
+
+// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
+
+namespace Foam
+{
+
+defineTypeNameAndDebug(DAStateInfoSimpleHeatTransferFoam, 0);
+addToRunTimeSelectionTable(DAStateInfo, DAStateInfoSimpleHeatTransferFoam, dictionary);
+
+// * * * * * * * * * * * * * * * * Constructors  * * * * * * * * * * * * * * //
+
+DAStateInfoSimpleHeatTransferFoam::DAStateInfoSimpleHeatTransferFoam(
+    const word modelType,
+    const fvMesh& mesh,
+    const DAOption& daOption,
+    const DAModel& daModel)
+    : DAStateInfo(modelType, mesh, daOption, daModel)
+{
+    /*
+    Description:
+        Register the names of state variables, see DAStateInfoSimpleFoam.
+
+        Connectivity differs from DASimpleFoam through nu(grad(U), T), which is
+        evaluated in every cell: a face flux of U in cell i uses nu of i and its
+        neighbours (lv1), whose grad(U) reaches lv2. So T enters URes/pRes/phiRes
+        wherever nut does, and TRes (dissipation nu*grad(U):grad(U)) sees U up
+        to lv1 besides T. The connectivity only shapes the coloring
+        preconditioner; the Jacobian-vector products are exact AD either way.
+
+                     U      T      p     nut    phi
+        URes         2      1      1      1      0
+        TRes         1      2             1      0
+        pRes         3      2      2      2      1
+        phiRes       2      1      1      1      0
+    */
+
+    stateInfo_["volScalarStates"].append("p");
+    stateInfo_["volScalarStates"].append("T");
+    stateInfo_["modelStates"].append("nut");
+    stateInfo_["volVectorStates"].append("U");
+    stateInfo_["surfaceScalarStates"].append("phi");
+
+    // correct the names for model states based on the selected physical model at runtime
+    daModel.correctModelStates(stateInfo_["modelStates"]);
+
+    stateResConInfo_.set(
+        "URes",
+        {
+            {"U", "p", "T", "nut", "phi"}, // lv0
+            {"U", "p", "T", "nut"}, // lv1
+            {"U"} // lv2
+        });
+
+    stateResConInfo_.set(
+        "TRes",
+        {
+            {"T", "U", "nut", "phi"}, // lv0
+            {"T", "U", "nut"}, // lv1
+            {"T"} // lv2
+        });
+
+    stateResConInfo_.set(
+        "pRes",
+        {
+            {"U", "p", "T", "nut", "phi"}, // lv0
+            {"U", "p", "T", "nut", "phi"}, // lv1
+            {"U", "p", "T", "nut"}, // lv2
+            {"U"} // lv3
+        });
+
+    stateResConInfo_.set(
+        "phiRes",
+        {
+            {"U", "p", "T", "nut", "phi"}, // lv0
+            {"U", "p", "T", "nut"}, // lv1
+            {"U"}, // lv2
+        });
+
+    // need to correct connectivity for physical models for each residual
+    daModel.correctStateResidualModelCon(stateResConInfo_["URes"]);
+    daModel.correctStateResidualModelCon(stateResConInfo_["TRes"]);
+    daModel.correctStateResidualModelCon(stateResConInfo_["pRes"]);
+    daModel.correctStateResidualModelCon(stateResConInfo_["phiRes"]);
+
+    // add physical model residual connectivity
+    daModel.addModelResidualCon(stateResConInfo_);
+}
+
+} // End namespace Foam
