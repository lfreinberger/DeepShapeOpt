+void DAColoring::petscD2Coloring(
+    const Mat conMat,
+    Vec colors,
+    label& nColors) const
+{
+    /*
+    Description:
+        Distance-2 column coloring of conMat with PETSc's MatColoring (greedy), the
+        coloring PETSc itself uses for finite-difference Jacobians: no two columns
+        with a nonzero in the same row share a color.
+
+        Same output as parallelD2Coloring: colors[i] = color of column i (as a
+        PetscScalar, in the column ownership of conMat), nColors = number of colors.
+    */
+
+    Info << "PETSc MatColoring (greedy, distance 2)..." << endl;
+
+    // Symmetric pattern B = A + A^T: two columns sharing a row r of A are both
+    // adjacent to r in B, i.e. within distance 2, so a distance-2 coloring of B is a
+    // valid column coloring of A (conservative). PETSc's greedy kernel crashed on the
+    // nonsymmetric A directly.
+    Mat At;
+    Mat B;
+    MatTranspose(conMat, MAT_INITIAL_MATRIX, &At);
+    MatDuplicate(conMat, MAT_COPY_VALUES, &B);
+    MatAXPY(B, 1.0, At, DIFFERENT_NONZERO_PATTERN);
+    MatDestroy(&At);
+
+    MatColoring mc;
+    ISColoring isColoring;
+    MatColoringCreate(B, &mc);
+    MatColoringSetDistance(mc, 2);
+    MatColoringSetType(mc, MATCOLORINGGREEDY);
+    MatColoringSetFromOptions(mc);
+    MatColoringApply(mc, &isColoring);
+
+    PetscInt nLocal;
+    PetscInt nc;
+    const ISColoringValue* localColors;
+    ISColoringGetColors(isColoring, &nLocal, &nc, &localColors);
+
+    PetscScalar* colorsArray;
+    VecGetArray(colors, &colorsArray);
+    for (PetscInt i = 0; i < nLocal; i++)
+    {
+        colorsArray[i] = localColors[i] * 1.0;
+    }
+    VecRestoreArray(colors, &colorsArray);
+
+    nColors = nc;
+
+    ISColoringDestroy(&isColoring);
+    MatColoringDestroy(&mc);
+    MatDestroy(&B);
+
+    Info << "PETSc MatColoring done: " << nColors << " colors" << endl;
+}
