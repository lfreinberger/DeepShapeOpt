#!/bin/bash
#SBATCH --job-name=transolver
#SBATCH --partition=gpu
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --time=48:00:00
#SBATCH --output=slurm_transolver_%j.out

# Transolver surrogate training on the generated flow dataset.
# Usage: sbatch run_train_transolver.slrm [config.json]
#   default config: experiments/transolver/config_train.json (feature set geo)
#   ablation C:     experiments/transolver/config_train_lat.json  (lat)
#                   experiments/transolver/config_train_geolat.json (geo+lat)

source tests/env.sh

CONFIG=${1:-experiments/transolver/config_train.json}
echo "config: $CONFIG"

uv run python scripts/train_transolver.py --config "$CONFIG"
